# Full endpoints, not base URLs: the path is part of the protocol.
GENERATE_URL=https://provider.example/v1/chat/completions
GENERATE_MODEL=deepseek-flash
GENERATE_API_KEY=...

DECIDE_URL=https://provider.example/v1/decide
DECIDE_MODEL=jev-preview
DECIDE_API_KEY=...

# The compiler agent: pi takes a base URL.
COMPILER_BASE_URL=https://provider.example/v1
# The recorded compiles used deepseek-flash, the same model as the generated nodes.
COMPILER_MODEL=deepseek-flash
COMPILER_API_KEY=...
